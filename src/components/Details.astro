---
// const props = Astro.props;

// strong typing recommended
interface Props {
  title: string;
}
const { title = "Learning objectives" } = Astro.props;
---

<div class="not-content callout-intro">
  <div class="componenttext">
    <details>
      <summary>{title}</summary>
      {/* By the end of this session you will be able to: */}
      <slot />
    </details>
  </div>
</div>

<style is:global>
  .componenttext {
    margin-top: 0.3rem;
  }
  .componenttext ul {
    margin-top: 0rem;
    /* background-color: red; */
  }
</style>
