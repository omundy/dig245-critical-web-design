---
// Overrides @astrojs/starlight/components/PageTitle.astro to render an
// optional `subtitle` frontmatter field under the page's H1.

// PAGE_TITLE_ID isn't part of Starlight's public API surface, so it's
// hardcoded here to match the upstream constant (used for the skip-link anchor).
const PAGE_TITLE_ID = "_top";

const { day, title, subtitle, date } = Astro.locals.starlightRoute.entry
  .data as {
  day?: string;
  title: string;
  subtitle?: string;
  date?: string;
};

import Icon from "@/components/Icon.astro";
---

<div class="flex items-center justify-between">
  <h1 id={PAGE_TITLE_ID}>
    {day && <span class="day-label">{day}</span>}
    {title}
  </h1>
  {
    date && (
      <div class="date">
        {" "}
        <Icon type="date" color="grey" weight="300">
          {/* inject html */}
          <Fragment set:html={date} />
        </Icon>{" "}
      </div>
    )
  }
</div>
{subtitle && <p class="subtitle">{subtitle}</p>}

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
    .day-label {
      color: var(--sl-color-gray-2);
      margin-right: 0.5rem;
    }
    .subtitle {
      margin-top: 0.5rem;
      font-size: var(--sl-text-lg);
      color: var(--sl-color-gray-2);
    }
    .date {
      margin-top: 0.5rem;
      font-size: var(--sl-text-lg);
      color: var(--sl-color-gray-2);
      /* position: relative;
      left: 390;
      top: 0; */
    }
  }
</style>
