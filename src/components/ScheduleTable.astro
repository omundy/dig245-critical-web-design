---
// Renders a table summarizing the frontmatter of every page in a schedule directory.

import { getCollection } from "astro:content";
import { getDateForEntry, getLabelForEntry, sortScheduleEntries } from "@/utils/schedule";
import PrepLink from "@/components/PrepLink.astro";

interface Props {
  directory: string;
  exclude: string[];
}
// index.mdx's collection id is just "schedule" (no trailing "/index"),
// so its slug (the part after "schedule/") is "" — exclude that too.
const { directory = "schedule", exclude = ["", "index"] } = Astro.props;

const entries = sortScheduleEntries(
  await getCollection("docs", (entry) => {
    if (entry.id !== directory && !entry.id.startsWith(`${directory}/`))
      return false;
    const slug =
      entry.id === directory ? "" : entry.id.slice(directory.length + 1);
    return !exclude.includes(slug) && !entry.data.draft;
  }),
);

// Resolved up front (Astro's JSX-returning .map() below can't itself await)
// and looked up by id while rendering.
const dates = new Map(
  await Promise.all(
    entries.map(async (entry) => [entry.id, await getDateForEntry(entry.id)] as const),
  ),
);
const labels = new Map(
  await Promise.all(
    entries.map(async (entry) => [entry.id, await getLabelForEntry(entry.id)] as const),
  ),
);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// A `break: true` entry (e.g. a week off) is a standalone group of its own,
// not part of whatever numbered week it happens to share a leading digit
// with in the filename/sort order — so it always gets its own group key,
// instead of grouping by its auto-numbered week (which would lump it in
// with the surrounding real sessions even though it's not one of them).
function groupKey(entry: { id: string; data: { break?: boolean | null } }, label: string | undefined): string {
  if (entry.data.break) return entry.id;
  return label ? (label.split("-")[0] as string) : entry.id;
}

// tracks group-to-group transitions as entries render in order: previousGroup
// flags the first row of each new group for a stronger top border, and
// groupIndex (only incremented on a real transition) drives shading so it
// alternates by group rather than by raw (and here, sometimes-shared) week number
let previousGroup: string | undefined;
let groupIndex = -1;
---

<table class="schedule-table">
  <thead>
    <tr>
      <th>Date</th>
      <th>Day</th>
      <th>Topic</th>
      <th>Deadlines</th>
      <th>Prep</th>
    </tr>
  </thead>
  <tbody>
    {
      entries.map((entry) => {
        const { title, deadlines, prep } = entry.data as {
          title: string;
          deadlines?: { url?: string; text: string }[];
          prep?: { url?: string; text: string }[];
        };
        const date = dates.get(entry.id);
        const label = labels.get(entry.id);
        const dayLabel = label ?? " ";
        const group = groupKey(entry, label);
        // skip the very first row: it already sits right under the header's
        // own border, so marking it too would draw a redundant double line
        const isGroupStart = previousGroup !== undefined && group !== previousGroup;
        if (previousGroup === undefined || isGroupStart) groupIndex++;
        previousGroup = group;
        return (
          <tr
            class:list={{
              "week-shade": groupIndex % 2 === 1,
              "week-start": isGroupStart,
            }}
          >
            <td>{date || " "}</td>
            <td>{dayLabel}</td>
            <td>
              <a href={`${base}/${entry.id}/`}>{title}</a>
            </td>
            <td>
              {deadlines && deadlines.length > 0 ? (
                <ul>
                  {deadlines.map((deadline) => (
                    <li>
                      <PrepLink url={deadline.url} text={deadline.text} />
                    </li>
                  ))}
                </ul>
              ) : (
                " "
              )}
            </td>
            <td>
              {prep && prep.length > 0 ? (
                <ul>
                  {prep.map((link) => (
                    <li>
                      <PrepLink url={link.url} text={link.text} />
                    </li>
                  ))}
                </ul>
              ) : (
                " "
              )}
            </td>
          </tr>
        );
      })
    }
  </tbody>
</table>

{
  entries.length === 0 && (
    <p class="not-content">
      No pages found in <code>{directory}/</code>.
    </p>
  )
}

{/* 
Styling for .schedule-table lives in src/styles/starlight-overrides.css,
not a scoped style block here — this component's own style block was
unreliably dropped from the build output on this page for reasons not
fully pinned down (reproduced even with a from-scratch, unrelated test
component, and survived a full cache wipe: dist/, .astro/,
node_modules/.astro/, node_modules/.vite/), so the global stylesheet is
used as the proven-reliable alternative. 
*/}
