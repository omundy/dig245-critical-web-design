---
// Renders a table summarizing the frontmatter of every page in a schedule directory.

import { getCollection } from "astro:content";
import { getDateForDay } from "@/utils/schedule";

interface Props {
  directory: string;
  exclude: string[];
}
// index.mdx's collection id is just "schedule" (no trailing "/index"),
// so its slug (the part after "schedule/") is "" — exclude that too.
const { directory = "schedule", exclude = ["", "index"] } = Astro.props;

const entries = await getCollection("docs", (entry) => {
  if (entry.id !== directory && !entry.id.startsWith(`${directory}/`))
    return false;
  const slug =
    entry.id === directory ? "" : entry.id.slice(directory.length + 1);
  return !exclude.includes(slug) && !entry.data.draft;
});

// "week-1" -> 1, "week-10" -> 10; entries without a number sort to the end, alphabetically
function weekNumber(id: string): number {
  const match = id.match(/(\d+)/);
  return match ? parseInt(match[1], 10) : Infinity;
}
entries.sort((a, b) => {
  const diff = weekNumber(a.id) - weekNumber(b.id);
  return diff !== 0 ? diff : a.id.localeCompare(b.id);
});

// frontmatter deadlines are plain strings, occasionally wrapped in *emphasis*
function parseDeadline(raw: string): { text: string; emphasis: boolean } {
  const trimmed = raw.trim();
  const emphasis =
    trimmed.startsWith("*") && trimmed.endsWith("*") && trimmed.length > 1;
  return { text: emphasis ? trimmed.slice(1, -1) : trimmed, emphasis };
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// tracks week-to-week transitions as entries render in order, so the
// first row of each new week can get a stronger top border below
let previousWeek: number | undefined;
---

<table class="schedule-table">
  <thead>
    <tr>
      <th>Date</th>
      <th>Day</th>
      <th>Week</th>
      <!-- <th>Deadlines</th> -->
      <th>Prep</th>
    </tr>
  </thead>
  <tbody>
    {
      entries.map((entry) => {
        const { day, title, deadlines, prep } = entry.data as {
          day?: string;
          title: string;
          deadlines?: string[];
          prep?: { url?: string; text: string }[];
        };
        const date = day ? getDateForDay(day) : undefined;
        const week = weekNumber(entry.id);
        // skip the very first row: it already sits right under the header's
        // own border, so marking it too would draw a redundant double line
        const isWeekStart = previousWeek !== undefined && week !== previousWeek;
        previousWeek = week;
        return (
          <tr
            class:list={{
              "week-shade": Number.isFinite(week) && week % 2 === 0,
              "week-start": isWeekStart,
            }}
          >
            <td>{date || " "}</td>
            <td>{day || " "}</td>
            <td>
              <a href={`${base}/${entry.id}/`}>{title}</a>
            </td>
            {/* <td>
              {deadlines && deadlines.length > 0 ? (
                <ul>
                  {deadlines.map((deadline) => {
                    const { text, emphasis } = parseDeadline(deadline);
                    return <li>{emphasis ? <em>{text}</em> : text}</li>;
                  })}
                </ul>
              ) : (
                "—"
              )}
            </td> */}
            <td>
              {prep && prep.length > 0 ? (
                <ul>
                  {prep.map((link) => (
                    <li>
                      {link.url ? (
                        <a href={link.url}>{link.text}</a>
                      ) : (
                        link.text
                      )}
                    </li>
                  ))}
                </ul>
              ) : (
                " "
              )}
            </td>
          </tr>
        );
      })
    }
  </tbody>
</table>

{
  entries.length === 0 && (
    <p class="not-content">
      No pages found in <code>{directory}/</code>.
    </p>
  )
}

{/* 
Styling for .schedule-table lives in src/styles/starlight-overrides.css,
not a scoped style block here — this component's own style block was
unreliably dropped from the build output on this page for reasons not
fully pinned down (reproduced even with a from-scratch, unrelated test
component, and survived a full cache wipe: dist/, .astro/,
node_modules/.astro/, node_modules/.vite/), so the global stylesheet is
used as the proven-reliable alternative. 
*/}
