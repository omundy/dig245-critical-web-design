---
// Renders one prep/deadline item: plain text, or a link when `url` is set,
// prefixed with a small YouTube icon when that link points to a YouTube
// video. Shared by ScheduleTable.astro (Deadlines/Prep columns) and
// MarkdownContent.astro (current-page and next-page-preview sections) so
// the YouTube-detection logic and icon markup exist in exactly one place.
import { extractYoutubeVideoId } from "@/utils/embed";

interface Props {
  url?: string;
  text: string;
}
const { url, text } = Astro.props;
const isYoutube = Boolean(url && extractYoutubeVideoId(url));
---

{
  isYoutube && (
    <svg
      class="youtube-icon"
      width="14"
      height="14"
      viewBox="0 0 14 14"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <g clip-path="url(#clip0_2347_953)">
        <path
          d="M14 2C14 0.895431 13.1046 0 12 0H2C0.89543 0 0 0.895431 0 2V10C0 11.1046 0.895431 12 2 12H12C13.1046 12 14 11.1046 14 10V2Z"
          fill="black"
        />
        <path d="M5 9V3L10 6L5 9Z" fill="white" />
      </g>
      <defs>
        <clipPath id="clip0_2347_953">
          <rect width="14" height="12" fill="white" />
        </clipPath>
      </defs>
    </svg>
  )
}
{url ? <a href={url}>{text}</a> : text}
